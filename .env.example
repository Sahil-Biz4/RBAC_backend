# ── Application ────────────────────────────────────────────────────────────
MODE=local                              # local | development | staging | production
PROJECT_NAME=Auth Module
VERSION=1.0.0

# ── Branding ────────────────────────────────────────────────────────────────
APP_NAME=AuthModule
SUPPORT_EMAIL=support@yourdomain.com
BRAND_COLOR=#1a1a2e


# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth_module

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080    # 7 days

# ── OTP ────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_MINUTES=60

# ── Password Reset ─────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=your-admin-secret-key-change-in-production

# ── Email (SendGrid) ───────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── Permissions ────────────────────────────────────────────────────────────
ALLOWED_RESOURCES=users,roles,permissions,profile
ALLOWED_ACTIONS=read,create,update,delete

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ── Docs protection (production only) ─────────────────────────────────────
DOCS_USERNAME=admin
DOCS_PASSWORD=change-in-production
