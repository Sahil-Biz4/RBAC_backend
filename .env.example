# ── Application ────────────────────────────────────────────────────────────
MODE=local                              # local | development | staging | production
PROJECT_NAME=AuthModule
VERSION=1.0.0

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth_module

# Connection pool (tune for production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080    # 7 days

# ── OTP ────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_MINUTES=60

# ── Password Reset ─────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ── Admin ──────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=your-admin-secret-key-change-in-production

# ── Email (SendGrid) ───────────────────────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── Redis (token blacklist + rate limiting) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=                 # Leave empty to use REDIS_URL

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Docs protection (production only) ─────────────────────────────────────
DOCS_USERNAME=admin
DOCS_PASSWORD=change-in-production
